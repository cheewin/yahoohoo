# Yahoohoo environment variables
# Copy to .env and modify as needed. All values shown are defaults.

# Transport: stdio (for local MCP clients) or http (for remote connectors)
# YAHOOHOO_TRANSPORT=stdio

# HTTP server settings (only used when transport=http)
# YAHOOHOO_HOST=127.0.0.1
# YAHOOHOO_PORT=3434
# YAHOOHOO_ALLOWED_HOSTS=localhost,127.0.0.1

# Market data
# YAHOOHOO_CACHE_TTL_MS=30000
# YAHOOHOO_DEFAULT_LOOKBACK_DAYS=180
# YAHOOHOO_DEFAULT_BENCHMARK=SPY
# YAHOOHOO_DEFAULT_SUMMARY_MODULES=price,summaryDetail,financialData,defaultKeyStatistics,calendarEvents,assetProfile

# Recursive analysis
# YAHOOHOO_REASONING_MODE=auto
# YAHOOHOO_MAX_DEPTH=2
# YAHOOHOO_MAX_CHILDREN=3
# YAHOOHOO_SAMPLING_MAX_TOKENS=900
# YAHOOHOO_SAMPLING_TEMPERATURE=0.2
# YAHOOHOO_ENABLE_SAMPLING=true

# Python sandbox
# YAHOOHOO_PYTHON=python3
# YAHOOHOO_SANDBOX_TIMEOUT_MS=20000
# YAHOOHOO_SANDBOX_CPU_SECONDS=10
# YAHOOHOO_SANDBOX_MEMORY_MB=512
# YAHOOHOO_SANDBOX_OUTPUT_BYTES=200000
# YAHOOHOO_SANDBOX_ALLOW_NUMPY=true
# YAHOOHOO_SANDBOX_ALLOW_PANDAS=true
# YAHOOHOO_SANDBOX_STRICT_FILES=false

# Logging
# YAHOOHOO_LOG_LEVEL=info

# Private remote HTTP: authentication is mandatory. Supply secrets in hosting Variables.
# YAHOOHOO_PUBLIC_URL=https://your-service.up.railway.app
# YAHOOHOO_OWNER_PASSWORD=
# YAHOOHOO_API_KEYS=
# YAHOOHOO_OAUTH_REDIRECT_URIS=https://chatgpt.com/connector_platform_oauth_redirect
# YAHOOHOO_RATE_LIMIT=60
# YAHOOHOO_MAX_SESSIONS=20
# YAHOOHOO_SESSION_TTL_MS=1800000
# YAHOOHOO_ENABLE_SAMPLING=false
# YAHOOHOO_LLM_QUERY=false
# COINGECKO_API_KEY=
